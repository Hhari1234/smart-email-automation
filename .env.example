# Copy this file to ".env" and fill in your details. Never commit the real .env file.

# =====================================================================
# Application
# =====================================================================
# "development" enables local reload and other dev conveniences.
# "production" disables reload, requires a real APP_SECRET_KEY, and
# enables the secure flag on session cookies. Use production for any
# public deployment.
APP_ENV=development

# Required for production (recommended for any deployment).
# A long random string, e.g. 64+ chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Optional: session lifetime in hours (default 12).
APP_SESSION_HOURS=12

# Optional: comma-separated list of extra origins allowed to call the API
# via cross-origin requests (e.g. "https://app.example.com"). When empty,
# the app is served same-origin and CORS is disabled entirely.
CORS_ALLOW_ORIGINS=

# =====================================================================
# Authentication
# =====================================================================
# The application now uses SQLite-backed user accounts. No need to set
# APP_USERNAME or APP_PASSWORD_HASH manually. Simply:
#   1. Start the application
#   2. Open http://localhost:8000/login
#   3. Click "Create Account"
#   4. Enter username and password
#   5. Account is stored securely in SQLite with bcrypt hashing
#
# Legacy support: If you previously used APP_USERNAME + APP_PASSWORD_HASH,
# the application will automatically migrate your legacy account to the
# database on first startup.

# =====================================================================
# SMTP fallback (used automatically if Gmail API isn't set up)
# =====================================================================
# Create a Gmail "App Password" at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on your Google account).
SMTP_EMAIL=your.email@gmail.com
SMTP_APP_PASSWORD=your16charapppassword

# =====================================================================
# Gmail API (preferred, optional)
# =====================================================================
# Only needed if you want to use the Gmail API instead of SMTP.
# 1. Go to https://console.cloud.google.com/ -> create a project
# 2. Enable the "Gmail API"
# 3. Create OAuth Client ID credentials -> Application type: Desktop App
# 4. Download the JSON and save it as credentials/credentials.json
GMAIL_CREDENTIALS_FILE=credentials/credentials.json
GMAIL_TOKEN_FILE=credentials/token.json
